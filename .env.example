# ============================================================
# Variables d'environnement — School's
# Copiez ce fichier en .env.local et renseignez vos valeurs.
# NE JAMAIS committer .env.local (déjà couvert par .gitignore).
# ============================================================

# URL de votre projet Supabase (Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co

# Clé publique "anon" / "publishable" — exposée côté client, protégée par la RLS.
# (Dashboard > Project Settings > API > Project API keys > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon_publique

# ------------------------------------------------------------
# NE JAMAIS mettre ici la clé service_role ni le mot de passe
# de la base : ils contournent la RLS et ne doivent jamais être
# exposés côté client ni committés.
# ------------------------------------------------------------

# ------------------------------------------------------------
# SMS — Nexah (nexah.net)
# Identifiants fournis par Nexah après activation du compte Bulk SMS
# (contact commercial : support@nexah.net / +237 694 003 333).
# NE JAMAIS exposer ces valeurs côté client : utilisées uniquement dans
# src/app/api/sms/send/route.ts, côté serveur.
# ------------------------------------------------------------
NEXAH_USER=
NEXAH_PASSWORD=
NEXAH_SENDER_ID=

# ------------------------------------------------------------
# Observabilité — Sentry (facultatif)
# Sans DSN, l'application n'envoie AUCUNE donnée : l'intégration
# est totalement inerte. Renseignez ces variables pour activer
# le reporting d'erreurs en production.
# ------------------------------------------------------------
# DSN public du projet Sentry (Settings > Client Keys (DSN))
NEXT_PUBLIC_SENTRY_DSN=

# Upload des sourcemaps au build (facultatif, CI uniquement).
# Nécessite un token créé dans Sentry (Settings > Auth Tokens).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
